MYSQL_DATABASE=workbench
# Must match the existing xp-mysql container's MYSQL_ROOT_PASSWORD.
MYSQL_ROOT_PASSWORD=read-from-xp-mysql
JWT_SECRET_KEY=replace-with-a-random-long-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://workbench.nexbyte.top,http://localhost:5173,http://localhost:5174,null
VITE_API_BASE=http://wbapi.nexbyte.top
DOCKER_MANAGER_URL=http://docker-manager:9100
DOCKER_MANAGER_TOKEN=replace-with-a-random-long-agent-token
DOCKER_PROTECTED_CONTAINERS=workbench-api,workbench-web,docker-manager,xp-mysql
